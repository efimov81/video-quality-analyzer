POSTGRES_DB=video_quality_analyze
POSTGRES_USER=app
POSTGRES_PASSWORD=change_me_local
POSTGRES_PORT=5434
DATABASE_URL=postgresql://app:change_me_local@localhost:5434/video_quality_analyze
VIDEO_STORAGE_DIR=./videos
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379
ANALYSIS_CONCURRENCY=1
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# YTDLP_PATH=/usr/local/bin/yt-dlp
# Origin frontend без завершающего слеша. При разработке Angular проксирует /api.
FRONTEND_ORIGIN=http://localhost:4200
# Для HTTPS. В production флаг Secure включён всегда.
SESSION_COOKIE_SECURE=false
# Токен от @BotFather. Оставьте пустым, чтобы бот не запускался.
TELEGRAM_BOT_TOKEN=
